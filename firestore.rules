rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function stageKeys() {
      return [
        'recon-0', 'recon-1', 'recon-2',
        'nmap-0', 'nmap-1', 'nmap-2',
        'network-0', 'network-1', 'network-2',
        'webgoat-0', 'webgoat-1', 'webgoat-2',
        'proxy-0', 'proxy-1', 'proxy-2',
        'metasploit-0', 'metasploit-1', 'metasploit-2',
        'logs-0', 'logs-1', 'logs-2',
        'integrity-0', 'integrity-1', 'integrity-2',
        'headers-0', 'headers-1', 'headers-2',
        'email-0', 'email-1', 'email-2'
      ];
    }

    function isStageMap(value) {
      return value is map && value.keys().hasOnly(stageKeys());
    }

    function isNullableDate(value) {
      return value == null || (value is string && value.size() <= 40);
    }

    function validDevices(devices) {
      return devices is map
        && devices.keys().hasAll(['kali', 'windows', 'target', 'network'])
        && devices.keys().hasOnly(['kali', 'windows', 'target', 'network'])
        && devices.kali in ['unknown', 'on', 'off']
        && devices.windows in ['unknown', 'on', 'off']
        && devices.target in ['unknown', 'on', 'off']
        && devices.network in ['unknown', 'isolated', 'notset'];
    }

    function validActivity(activity) {
      return activity == null || (
        activity is map
        && activity.keys().hasAll(['trackId', 'stageIndex', 'at'])
        && activity.keys().hasOnly(['trackId', 'stageIndex', 'at'])
        && activity.trackId in ['recon', 'nmap', 'network', 'webgoat', 'proxy', 'metasploit', 'logs', 'integrity', 'headers', 'email']
        && activity.stageIndex is int
        && activity.stageIndex >= 0 && activity.stageIndex <= 2
        && activity.at is string && activity.at.size() <= 40
      );
    }

    // The client additionally checks each note, date and checklist value before
    // sending or using a snapshot, and caps UTF-8 payloads below 700,000 bytes.
    // These rules enforce ownership, the exact document envelope, and bounded
    // top-level progress structure. They do not parse arbitrary note contents.
    function validProgress(progress) {
      return progress is map
        && progress.keys().hasAll([
          'checks', 'notes', 'results', 'completed', 'devices', 'logs',
          'lastActivity', 'updatedAt', 'stageUpdatedAt'
        ])
        && progress.keys().hasOnly([
          'checks', 'notes', 'results', 'completed', 'devices', 'logs',
          'lastActivity', 'updatedAt', 'stageUpdatedAt'
        ])
        && isStageMap(progress.checks)
        && isStageMap(progress.notes)
        && isStageMap(progress.results)
        && isStageMap(progress.completed)
        && isStageMap(progress.stageUpdatedAt)
        && validDevices(progress.devices)
        && progress.logs is list && progress.logs.size() <= 100
        && validActivity(progress.lastActivity)
        && isNullableDate(progress.updatedAt);
    }

    function validEnvelope() {
      let data = request.resource.data;
      return data.keys().hasAll(['schemaVersion', 'revision', 'progress', 'updatedAt'])
        && data.keys().hasOnly(['schemaVersion', 'revision', 'progress', 'updatedAt'])
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.revision is int && data.revision >= 1 && data.revision <= 2147483647
        && validProgress(data.progress)
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    match /blackboxUsers/{uid}/state/progress {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && validEnvelope() && request.resource.data.revision == 1;
      allow update: if isOwner(uid) && validEnvelope()
        && request.resource.data.revision == resource.data.revision + 1;
      // Clearing progress writes an empty valid snapshot at the next revision.
      // Direct deletion and collection listing are intentionally not permitted.
      allow delete, list: if false;
    }

    function isKnownCybertraceCase(caseId) {
      return caseId in [
        'INC-0417', 'INC-0512', 'INC-0633', 'INC-0701',
        'INC-0755', 'INC-0812', 'INC-0890', 'INC-0944',
        'INC-1002', 'INC-1055', 'INC-1101', 'INC-1102',
        'INC-1103', 'INC-1104', 'INC-1105', 'INC-1106',
        'INC-1201', 'INC-1202', 'INC-1203', 'INC-1204',
        'INC-1205', 'INC-1206', 'INC-1207', 'INC-1208',
        'INC-1209', 'INC-1210', 'INC-1211', 'INC-1212'
      ];
    }

    function validCybertraceReceipt(caseId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'schemaVersion', 'source', 'caseId', 'bestScore',
          'firstSyncedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion', 'source', 'caseId', 'bestScore',
          'firstSyncedAt', 'updatedAt'
        ])
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.source == 'cybertrace'
        && data.caseId == caseId
        && isKnownCybertraceCase(caseId)
        && data.bestScore is int && data.bestScore >= 0 && data.bestScore <= 70
        && data.firstSyncedAt is timestamp
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    // Complementary investigation skills have their own owner-scoped records.
    // They never complete practical lab stages or modify the progress document.
    match /blackboxUsers/{uid}/cybertrace/{caseId} {
      allow get, list: if isOwner(uid);
      allow create: if isOwner(uid) && validCybertraceReceipt(caseId)
        && request.resource.data.firstSyncedAt == request.time;
      allow update: if isOwner(uid) && validCybertraceReceipt(caseId)
        && request.resource.data.firstSyncedAt == resource.data.firstSyncedAt
        && request.resource.data.bestScore > resource.data.bestScore;
      allow delete: if false;
    }

    // Reserved for independently verified results written by trusted backend only.
    // Admin SDK bypasses these client rules; NEVER grant client write access here.
    // Existing /cybertrace receipts remain user-reported legacy progress.
    match /blackboxUsers/{uid}/verifiedCybertrace/{caseId} {
      allow get, list: if isOwner(uid);
      allow create, update, delete: if false;
    }

    // SOC grading security boundary. Challenge data and answer keys are server-only.
    // Result reads are owner-scoped, and ALL writes use Admin SDK transactions.
    match /socVerifiedCatalog/{shiftId} {
      allow read, write: if false;
    }
    match /socVerifiedRubrics/{shiftId} {
      allow read, write: if false;
    }
    match /socVerifiedSessions/{sessionId} {
      allow read, write: if false;
    }
    match /socVerifiedQuotas/{uid} {
      allow read, write: if false;
    }
    match /blackboxUsers/{uid}/verifiedSocShifts/{shiftId} {
      allow get, list: if isOwner(uid);
      allow create, update, delete: if false;
    }

    // Server-owned staged lab knowledge assessment, fully separate from
    // client-checkable progress. The certificate issuance gate is still OFF.
    match /labStageCatalog/{stageKey} { allow read, write: if false; }
    match /labStageRubrics/{stageKey} { allow read, write: if false; }
    match /labStageSessions/{sessionId} { allow read, write: if false; }
    match /labStageQuotas/{uid} { allow read, write: if false; }
    match /blackboxUsers/{uid}/verifiedLabStages/{stageKey} {
      allow get, list: if isOwner(uid);
      allow create, update, delete: if false;
    }

    // Final group examination is server-issued and server-scored.
    // Private rubrics, sessions, quota, review evidence and audit are never
    // directly writable by the learner. Manual training notes are untrusted.
    match /defenseFinalCatalog/{groupId} { allow read, write: if false; }
    match /defenseFinalRubrics/{groupId} { allow read, write: if false; }
    match /defenseFinalSessions/{sessionId} { allow read, write: if false; }
    match /defenseFinalQuota/{uid} { allow read, write: if false; }
    match /defenseFinalReviewAudit/{auditId} { allow read, write: if false; }
    match /blackboxUsers/{uid}/defenseFinalResults/{groupId} {
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;
    }
    match /blackboxUsers/{uid}/defenseFinalEvidence/{groupId} {
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;
    }

    // Strong dual-account identity linkage: never let clients forge, enumerate
    // or replace link/claim documents. Authenticated read is owner-scoped.
    match /blackboxUsers/{uid}/identityLinks/{provider} {
      allow get: if isOwner(uid) && provider == 'cybertrace';
      allow list, create, update, delete: if false;
    }
    match /cybertraceIdentityClaims/{claimId} {
      allow read, write: if false;
    }

    // Reserved server-owned suite membership records. Admin SDK only; never grant client access.
    match /suiteMemberships/{uid} {
      allow read, write: if false;
    }

    // Public certificate details are returned by a restricted server endpoint.
    // Browsers may neither enumerate nor forge server-issued records.
    match /certificateRegistry/{certificateId} {
      allow read, write: if false;
    }

    // Private policy and revocation audit are NEVER exposed to clients.
    // Owner may only read their issued certificate pointer, never create or
    // update awards. The source-of-truth registry remains server-only.
    match /certificatePolicies/{policyId} {
      allow read, write: if false;
    }
    match /blackboxUsers/{uid}/certificateAwards/{awardId} {
      allow get, list: if isOwner(uid);
      allow create, update, delete: if false;
    }
    match /certificateRevocationAudit/{certificateId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
